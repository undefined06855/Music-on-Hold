{
    "geode": "5.10.1",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },

    "version": "v1.0.0",
    "id": "undefined0.music-on-hold",
    "name": "Music on Hold",
    "developer": "undefined0",
    "description": "Adds muffled music from the level when you pause!",
    "tags": [ "music" ],

    "links": {
        "source": "https://github.com/undefined06855/Music-on-Hold"
    },

    "settings": {
        "low-pass-cutoff": {
            "name": "Low-Pass Filter Cutoff",
            "description": "The cutoff for the low-pass filter, in hertz. Lower values are more muffled.",
            "type": "int",
            "default": 800,
            "min": 50,
            "max": 2500,
            "control": {
                "arrows": false,
                "big-arrows": false,
                "slider": true,
                "slider-step": 50
            }
        },
        "fader-gain": {
            "name": "Gain",
            "description": "The gain to apply to the fader filter, in decibels. Lower values are quieter.",
            "type": "int",
            "default": -5,
            "min": 10,
            "max": 0,
            "control": {
                "arrows": false,
                "big-arrows": false,
                "slider": true,
                "slider-step": 1
            }
        }
    }
}
